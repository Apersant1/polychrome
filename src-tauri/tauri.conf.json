{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polychrome",
  "version": "0.1.0",
  "identifier": "com.local.polychrome",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Polychrome",
        "width": 1400,
        "height": 920,
        "minWidth": 1200,
        "minHeight": 780,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0a0e16"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}